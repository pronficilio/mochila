APP_PASSWORD=mochi
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
JOB_TTL_SECONDS=86400
FILE_TTL_SECONDS=86400
MAX_FILESIZE=2G
DOWNLOAD_TIMEOUT_SECONDS=3600
DOWNLOAD_EGRESS=direct
# Mochila resolves YouTube names as IPv4 on the worker and sends media through SOCKS.
# Example: socks5://100.77.149.28:1080
RESIDENTIAL_PROXY=
# Private HTTP endpoint of the Compose-only BgUtils PO Token Provider.
YOUTUBE_POT_PROVIDER_URL=http://pot-provider:4416
DEFAULT_MAX_HEIGHT=1080
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=60
